# ── API Keys ─────────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=your_openrouter_api_key_here
GROQ_API_KEY=your_groq_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here
HF_TOKEN=your_huggingface_token_here

# ── Service URLs (override to point to different providers) ───────────────────
OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_EMBED_URL=https://openrouter.ai/api/v1/embeddings
TAVILY_API_URL=https://api.tavily.com/search
HF_IMAGE_API_URL=https://api-inference.huggingface.co/models/stabilityai/sdxl-turbo
POLLINATIONS_URL=https://image.pollinations.ai/prompt

# ── Model Names (override to switch models without touching code) ─────────────
LLM_MODEL=openai/gpt-oss-120b:free
LLM_MODEL_FALLBACK=openai/gpt-oss-20b:free
LLM_VISION_MODEL=openai/gpt-4o-mini
EMBED_MODEL=text-embedding-3-small
